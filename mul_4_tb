module mul_4_tb;

    logic [3:0] a;
    logic [3:0] b;
    logic [7:0] result;

    mul_4 dut (
        .a(a),
        .b(b),
        .result(result)
    );

    integer i, j, errors;

    initial begin
        errors = 0;

        for (i = 0; i < 16; i++) begin
            for (j = 0; j < 16; j++) begin
                a = i; b = j;
                #10;
                if (result !== i * j) begin
                    $display("FAIL: a=%0d b=%0d result=%0d expected=%0d", a, b, result, i*j);
                    errors++;
                end
            end
        end

        if (errors == 0)
            $display("mul_4: all 256 tests PASSED");
        else
            $display("mul_4: %0d ERRORS", errors);

        $stop;
    end

endmodule
